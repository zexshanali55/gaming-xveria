# ------------------------------------------------------------------ core
# Any PostgreSQL (Neon / Supabase free tier is plenty).
DATABASE_URL=postgresql://user:pass@host:5432/xveria

# The live domain, https. PayFast's return + IPN URLs are built from this.
SITE_URL=https://gamingxveria.com

# Long random string. Signs login cookies and mock payments.
SESSION_SECRET=change-me-to-a-long-random-string

# First admin, created by `npm run db:seed`.
ADMIN_EMAIL=admin@gamingxveria.com
ADMIN_PASSWORD=Xveria@2026

# ------------------------------------------------------------------ payfast
# mock    = no network call, payment simulated as approved (demo / dev)
# sandbox = https://ipguat.apps.net.pk with test credentials
# live    = https://ipg1.apps.net.pk
PAYFAST_MODE=mock

# Secured key is server-side only. Never prefix with NEXT_PUBLIC_.
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_SECURED_KEY=
PAYFAST_SANDBOX_STORE_ID=

PAYFAST_LIVE_MERCHANT_ID=
PAYFAST_LIVE_SECURED_KEY=
PAYFAST_LIVE_STORE_ID=

PAYFAST_MERCHANT_NAME=Gaming Xveria
PAYFAST_CURRENCY=PKR
